# Secrets and per-machine config
.claude/settings.local.json
.env
.env.*
!.env.example
_channel/config.local.yaml

# Local media cache (pulled from Google Drive on demand by tools/media.py)
_media/

# Media and transcripts live on Google Drive, never in git (safety net)
*.mp4
*.mov
*.mxf
*.avi
*.mkv
*.m4v
*.wav
*.mp3
*.aif
*.aiff
*.m4a
*.flac
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.exr
*.psd
*.heic
*.webp
*.avif
*.srt
*.vtt
*.pdf
!docs/*.pdf
*.aep
*.prproj
*.drp

# Python / OS / editors
.venv/
__pycache__/
*.pyc
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

edit/


# Uppercase variants (gitignore patterns are case-sensitive)
*.MP4
*.MOV
*.MXF
*.AVI
*.MKV
*.M4V
*.WAV
*.MP3
*.M4A
*.PNG
*.JPG
*.JPEG
*.SRT
